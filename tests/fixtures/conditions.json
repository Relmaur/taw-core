{
  "about": "Conditions (ADR-0013). `shape` cases: the errors Condition::normalize() reports (PHP) and the editor's validator (TypeScript, Step 2) must agree on. `evaluate` cases: Condition\\Evaluator with `values` as the tokens' text (dates as Y-m-d H:i:s), `now` and `timezone`; tokens not listed read as empty.",
  "now": "2026-09-26 15:30:00",
  "timezone": "America/Mexico_City",
  "values": {
    "@book_year": "1965",
    "@book_subtitle": "",
    "@post.type": "Book",
    "@post.title": "Dune",
    "@post.date": "2026-09-10 09:00:00",
    "@genre": "Fiction",
    "@tags": "classic, Space Opera, desert",
    "@price": "249.50",
    "@stock": "0",
    "@featured": "1",
    "@viewer.logged_in": "",
    "@first_year": "1965",
    "@email": "frank@example.com"
  },
  "shape": [
    { "name": "a valid condition", "condition": { "match": "all", "rules": [{ "value": "@book_year", "op": "not_empty" }] }, "errors": [] },
    { "name": "match defaults to all", "condition": { "rules": [{ "value": "@book_year", "op": "empty" }] }, "errors": [] },
    { "name": "no rules is valid (always shown)", "condition": { "rules": [] }, "errors": [] },
    { "name": "not an object", "condition": "yes", "errors": [{ "code": "invalid", "path": "rules" }] },
    { "name": "a bad match", "condition": { "match": "some", "rules": [] }, "errors": [{ "code": "bad_match", "path": "match" }] },
    { "name": "an unknown operator", "condition": { "rules": [{ "value": "@book_year", "op": "matches", "to": ".*" }] }, "errors": [{ "code": "unknown_op", "path": "rules.0.op" }] },
    { "name": "a value that isn't a token", "condition": { "rules": [{ "value": "book_year", "op": "empty" }] }, "errors": [{ "code": "invalid_value", "path": "rules.0.value" }] },
    { "name": "a value with text around it", "condition": { "rules": [{ "value": "@book_year is", "op": "empty" }] }, "errors": [{ "code": "invalid_value", "path": "rules.0.value" }] },
    { "name": "a value with a bad call", "condition": { "rules": [{ "value": "@book_year.shout()", "op": "empty" }] }, "errors": [{ "code": "invalid_value", "path": "rules.0.value" }] },
    { "name": "missing to", "condition": { "rules": [{ "value": "@genre", "op": "equals" }] }, "errors": [{ "code": "invalid_to", "path": "rules.0.to" }] },
    { "name": "a pair needs two", "condition": { "rules": [{ "value": "@price", "op": "between", "to": [1] }] }, "errors": [{ "code": "invalid_to", "path": "rules.0.to" }] },
    { "name": "a list as text", "condition": { "rules": [{ "value": "@genre", "op": "in", "to": "fiction, poetry" }] }, "errors": [] },
    { "name": "an operand token must be valid", "condition": { "rules": [{ "value": "@genre", "op": "equals", "to": "@x.nope()" }] }, "errors": [{ "code": "invalid_to", "path": "rules.0.to" }] },
    { "name": "@@ is text", "condition": { "rules": [{ "value": "@genre", "op": "equals", "to": "@@x.nope()" }] }, "errors": [] },
    { "name": "one nested group", "condition": { "match": "any", "rules": [{ "value": "@featured", "op": "is_true" }, { "match": "all", "rules": [{ "value": "@price", "op": "lt", "to": 300 }] }] }, "errors": [] },
    { "name": "two levels deep", "condition": { "rules": [{ "rules": [{ "rules": [] }] }] }, "errors": [{ "code": "too_deep", "path": "rules.0.rules.0" }] },
    {
      "name": "too many rules",
      "condition": { "rules": [
        { "value": "@a", "op": "empty" }, { "value": "@a", "op": "empty" }, { "value": "@a", "op": "empty" }, { "value": "@a", "op": "empty" },
        { "value": "@a", "op": "empty" }, { "value": "@a", "op": "empty" }, { "value": "@a", "op": "empty" }, { "value": "@a", "op": "empty" },
        { "value": "@a", "op": "empty" }, { "value": "@a", "op": "empty" }, { "value": "@a", "op": "empty" }, { "value": "@a", "op": "empty" },
        { "value": "@a", "op": "empty" }, { "value": "@a", "op": "empty" }, { "value": "@a", "op": "empty" }, { "value": "@a", "op": "empty" },
        { "value": "@a", "op": "empty" }, { "value": "@a", "op": "empty" }, { "value": "@a", "op": "empty" }, { "value": "@a", "op": "empty" },
        { "value": "@a", "op": "empty" }
      ] },
      "errors": [{ "code": "too_many_rules", "path": "rules" }]
    }
  ],
  "evaluate": [
    { "name": "not_empty", "rule": { "value": "@book_year", "op": "not_empty" }, "shown": true },
    { "name": "empty", "rule": { "value": "@book_subtitle", "op": "empty" }, "shown": true },
    { "name": "an unknown value is empty", "rule": { "value": "@nothing", "op": "empty" }, "shown": true },
    { "name": "equals ignores case and spaces", "rule": { "value": "@post.type", "op": "equals", "to": " book " }, "shown": true },
    { "name": "not_equals", "rule": { "value": "@post.type", "op": "not_equals", "to": "Page" }, "shown": true },
    { "name": "contains", "rule": { "value": "@email", "op": "contains", "to": "@@example" }, "shown": true },
    { "name": "contains nothing is false", "rule": { "value": "@email", "op": "contains", "to": "" }, "shown": false },
    { "name": "not_contains", "rule": { "value": "@post.title", "op": "not_contains", "to": "messiah" }, "shown": true },
    { "name": "starts_with", "rule": { "value": "@post.title", "op": "starts_with", "to": "du" }, "shown": true },
    { "name": "ends_with", "rule": { "value": "@email", "op": "ends_with", "to": ".com" }, "shown": true },
    { "name": "in", "rule": { "value": "@genre", "op": "in", "to": ["poetry", "fiction"] }, "shown": true },
    { "name": "in, as text", "rule": { "value": "@genre", "op": "in", "to": "poetry, drama" }, "shown": false },
    { "name": "not_in", "rule": { "value": "@genre", "op": "not_in", "to": ["poetry"] }, "shown": true },
    { "name": "has", "rule": { "value": "@tags", "op": "has", "to": "space opera" }, "shown": true },
    { "name": "has is whole items", "rule": { "value": "@tags", "op": "has", "to": "space" }, "shown": false },
    { "name": "has_not", "rule": { "value": "@tags", "op": "has_not", "to": "romance" }, "shown": true },
    { "name": "gt", "rule": { "value": "@price", "op": "gt", "to": 200 }, "shown": true },
    { "name": "gte equal", "rule": { "value": "@book_year", "op": "gte", "to": "1965" }, "shown": true },
    { "name": "lt", "rule": { "value": "@stock", "op": "lt", "to": 1 }, "shown": true },
    { "name": "lte", "rule": { "value": "@price", "op": "lte", "to": 249 }, "shown": false },
    { "name": "a word is not a number", "rule": { "value": "@genre", "op": "gt", "to": 1 }, "shown": false },
    { "name": "between", "rule": { "value": "@price", "op": "between", "to": [100, 300] }, "shown": true },
    { "name": "between, reversed", "rule": { "value": "@price", "op": "between", "to": [300, 100] }, "shown": true },
    { "name": "compared with another value", "rule": { "value": "@book_year", "op": "equals", "to": "@first_year" }, "shown": true },
    { "name": "after a relative date", "rule": { "value": "@post.date", "op": "after", "to": "-30 days" }, "shown": true },
    { "name": "before a relative date", "rule": { "value": "@post.date", "op": "before", "to": "-1 week" }, "shown": true },
    { "name": "before today", "rule": { "value": "@post.date", "op": "before", "to": "today" }, "shown": true },
    { "name": "after an absolute date", "rule": { "value": "@post.date", "op": "after", "to": "2026-09-11" }, "shown": false },
    { "name": "on the same day", "rule": { "value": "@post.date", "op": "on", "to": "2026-09-10" }, "shown": true },
    { "name": "between dates, inclusive by day", "rule": { "value": "@post.date", "op": "between_dates", "to": ["2026-09-01", "2026-09-10"] }, "shown": true },
    { "name": "a word is not a date", "rule": { "value": "@genre", "op": "before", "to": "today" }, "shown": false },
    { "name": "no weird relative dates", "rule": { "value": "@post.date", "op": "before", "to": "next monday" }, "shown": false },
    { "name": "is_true", "rule": { "value": "@featured", "op": "is_true" }, "shown": true },
    { "name": "is_false on 0", "rule": { "value": "@stock", "op": "is_false" }, "shown": true },
    { "name": "is_false on empty", "rule": { "value": "@viewer.logged_in", "op": "is_false" }, "shown": true },
    { "name": "all: one fails", "condition": { "match": "all", "rules": [{ "value": "@book_year", "op": "not_empty" }, { "value": "@book_subtitle", "op": "not_empty" }] }, "shown": false },
    { "name": "any: one holds", "condition": { "match": "any", "rules": [{ "value": "@book_subtitle", "op": "not_empty" }, { "value": "@book_year", "op": "not_empty" }] }, "shown": true },
    { "name": "a nested group", "condition": { "match": "all", "rules": [{ "value": "@post.type", "op": "equals", "to": "book" }, { "match": "any", "rules": [{ "value": "@viewer.logged_in", "op": "is_true" }, { "value": "@price", "op": "lt", "to": 300 }] }] }, "shown": true },
    { "name": "no rules shows", "condition": { "rules": [] }, "shown": true },
    { "name": "an invalid condition hides", "condition": { "rules": [{ "value": "@book_year", "op": "matches" }] }, "shown": false }
  ]
}
