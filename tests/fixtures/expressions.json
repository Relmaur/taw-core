    {"name": "a namespace word used as a field, with a call", "expr": "@date.upper()", "parts": [{"name": "date", "calls": [{"fn": "upper", "args": []}], "at": 0, "length": 13}], "errors": []},
    {"name": "loop row and position", "expr": "@loop.index. @row.award (@row.year)", "parts": [{"name": "loop.index", "calls": [], "at": 0, "length": 11}, {"text": ". "}, {"name": "row.award", "calls": [], "at": 13, "length": 10}, {"text": " ("}, {"name": "row.year", "calls": [], "at": 25, "length": 9}, {"text": ")"}], "errors": []},
    {"name": "v2: a formula in text", "expr": "Item @(@loop.index + 1) of @loop.count", "parts": [{"text": "Item "}, {"expr": {"type": "binary", "op": "+", "left": {"type": "ref", "name": "loop.index"}, "right": {"type": "number", "value": 1}}, "at": 5, "length": 18}, {"text": " of "}, {"name": "loop.count", "calls": [], "at": 27, "length": 11}], "errors": []},
