    {"name": "v2: methods on a formula and inside it", "expr": "@(@price * 1.16).upper() @(@row.name.truncate(5))", "parts": [{"expr": {"type": "call", "fn": "upper", "args": [{"type": "binary", "op": "*", "left": {"type": "ref", "name": "price"}, "right": {"type": "number", "value": 1.16}}]}, "at": 0, "length": 24}, {"text": " "}, {"expr": {"type": "call", "fn": "truncate", "args": [{"type": "ref", "name": "row.name"}, {"type": "number", "value": 5}]}, "at": 25, "length": 24}], "errors": []},
    {"name": "v2: bare and nested calls, booleans", "expr": "@coalesce(@a, empty(@b), true, 'x')", "parts": [{"expr": {"type": "call", "fn": "coalesce", "args": [{"type": "ref", "name": "a"}, {"type": "call", "fn": "empty", "args": [{"type": "ref", "name": "b"}]}, {"type": "bool", "value": true}, {"type": "text", "value": "x"}]}, "at": 0, "length": 35}], "errors": []},
    {"name": "v2: a period after a formula is text", "expr": "Total @(@a + @b).", "parts": [{"text": "Total "}, {"expr": {"type": "binary", "op": "+", "left": {"type": "ref", "name": "a"}, "right": {"type": "ref", "name": "b"}}, "at": 6, "length": 10}, {"text": "."}], "errors": []},
