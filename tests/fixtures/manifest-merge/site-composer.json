{
    "name": "taw/theme",
    "description": "TAW Theme — WordPress starter theme built on taw/core",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Site Owner",
            "email": "owner@example.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "emailit/emailit-php": "^2.0",
        "taw/core": "^1.0",
        "taw/hub-companion": "^0.3"
    },
    "autoload": {
        "psr-4": {
            "TAW\\Blocks\\": "Blocks/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TAW\\Theme\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Relmaur/taw-core"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Relmaur/taw-hub-companion"
        }
    ],
    "scripts": {
        "post-create-project-cmd": [
            "npm install --silent"
        ],
        "phpstan": "phpstan analyse --memory-limit=-1",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "extra": {
        "taw-companion": {
            "keys": {
                "taw-fleet": "AAAAtest-fleet-public-keyAAAAAAAAAAAAAAAAAAA="
            }
        }
    }
}
