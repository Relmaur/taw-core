{
    "name": "taw-lens",
    "version": "0.0.0",
    "description": "TAW Lens page script: the dev-only picker, inspect card, structure tree and chat panel (umbrella ADR-0006, taw/core ADR-0020). Built into ../../assets/lens/ (committed).",
    "private": true,
    "license": "GPL-2.0-or-later",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "dependencies": {
        "preact": "11.0.1"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/preact": "3.2.6",
        "@types/node": "22.20.4",
        "eslint": "9.39.5",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.12.0",
        "jsdom": "30.1.1",
        "prettier": "3.9.9",
        "typescript": "5.9.3",
        "typescript-eslint": "8.70.1",
        "vite": "8.3.1",
        "vitest": "5.0.2"
    }
}
