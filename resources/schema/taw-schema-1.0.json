{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taw.mlizardo.com/schema/taw-schema-1.0.json",
  "title": "TAW Schema definition 1.0",
  "description": "One post type, taxonomy, fieldset, options page or editing policy for the TAW schema registry (ADR-0004, ADR-0005). Put files in a taw-schema/ folder in the theme (or wp-content/taw-schema/). The authoritative check is TAW\\Core\\Schema\\Validator (php bin/taw schema:validate); this file mirrors it for editor autocomplete.",
  "type": "object",
  "required": ["version", "kind", "key"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "kind": { "enum": ["post_type", "taxonomy", "fieldset", "options_page", "editing"] },
    "key": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "override": {
      "type": "boolean",
      "description": "Set when this definition deliberately replaces a lower-precedence one of the same kind and key."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "post_type" } } },
      "then": {
        "properties": {
          "$schema": true, "version": true, "kind": true, "key": { "maxLength": 20 }, "override": true,
          "labels": { "$ref": "#/$defs/labels" },
          "args": { "type": "object", "description": "Passed to register_post_type(). Defaults: public + show_in_rest on; custom-fields is always added to supports." },
          "editing": { "$ref": "#/$defs/contentRule", "description": "How the block editor is locked down for this post type (applied when the theme calls Boot::editing()). The site's editing policy can override it." }
        },
        "additionalProperties": false
      }
    },
    {
      "if": { "properties": { "kind": { "const": "taxonomy" } } },
      "then": {
        "required": ["for"],
        "properties": {
          "$schema": true, "version": true, "kind": true, "key": { "maxLength": 32 }, "override": true,
          "for": { "$ref": "#/$defs/stringList", "description": "Post types this taxonomy attaches to." },
          "labels": { "$ref": "#/$defs/labels" },
          "args": { "type": "object", "description": "Passed to register_taxonomy(). Default: show_in_rest on." }
        },
        "additionalProperties": false
      }
    },
    {
      "if": { "properties": { "kind": { "const": "fieldset" } } },
      "then": {
        "required": ["on", "fields"],
        "properties": {
          "$schema": true, "version": true, "kind": true, "key": true, "override": true,
          "title": { "type": "string" },
          "on": { "$ref": "#/$defs/stringList", "description": "Post types, page slugs or template filenames (e.g. page-about.php) — same as Metabox screens." },
          "fields": { "$ref": "#/$defs/fieldList" },
          "context": { "enum": ["normal", "side", "advanced"] },
          "priority": { "enum": ["high", "default", "low"] },
          "prefix": { "type": "string", "description": "Meta key prefix. Default _taw_." },
          "config": { "type": "object", "description": "Any other Metabox config key (tabs, icon, …)." }
        },
        "additionalProperties": false
      }
    },
    {
      "if": { "properties": { "kind": { "const": "options_page" } } },
      "then": {
        "required": ["fields"],
        "properties": {
          "$schema": true, "version": true, "kind": true, "key": true, "override": true,
          "title": { "type": "string" },
          "menu_title": { "type": "string" },
          "capability": { "type": "string" },
          "fields": { "$ref": "#/$defs/fieldList" },
          "config": { "type": "object", "description": "Any other OptionsPage config key (prefix, tabs, icon, position, …)." }
        },
        "additionalProperties": false
      }
    },
    {
      "if": { "properties": { "kind": { "const": "editing" } } },
      "then": {
        "properties": {
          "$schema": true, "version": true, "kind": true, "override": true,
          "key": { "const": "site", "description": "A site has one editing policy." },
          "preset": { "$ref": "#/$defs/level", "description": "Starting level for every layer. TAW_EDITING_PRESET in wp-config.php replaces it per install." },
          "bypass": {
            "type": "object",
            "properties": {
              "capability": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "Users with this capability aren't locked (default taw_unlock_editing); neither are users in TAW_EDITING_BYPASS_USERS." }
            },
            "additionalProperties": false
          },
          "themeBlocks": { "type": "array", "items": { "type": "string", "pattern": "^(\\*|[a-z0-9-]+/(\\*|[a-z0-9-]+))$" }, "description": "The theme's own blocks (names or globs, e.g. taw-gutenberg/*), added to every content allow list, the curated one included. Levels that allow every block are unchanged." },
          "layers": {
            "type": "object",
            "properties": {
              "content": {
                "description": "A level for the default post types (page), or post type → rule.",
                "oneOf": [
                  { "$ref": "#/$defs/level" },
                  { "type": "object", "propertyNames": { "pattern": "^[a-z0-9_-]{1,20}$" }, "additionalProperties": { "$ref": "#/$defs/contentRule" } }
                ]
              },
              "site": { "$ref": "#/$defs/siteLayer" },
              "design": { "$ref": "#/$defs/designLayer" },
              "features": { "$ref": "#/$defs/featuresLayer" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "$defs": {
    "labels": {
      "type": "object",
      "required": ["singular", "plural"],
      "properties": {
        "singular": { "type": "string", "minLength": 1 },
        "plural": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "fieldList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/field" }
    },
    "field": {
      "type": "object",
      "required": ["id", "type"],
      "description": "A Metabox field. Keys not listed here (conditions, width, layout, editor, …) are passed through as-is.",
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": {
          "enum": [
            "text", "url", "number", "textarea", "wysiwyg", "select", "checkbox",
            "color", "datepicker", "range", "image", "icon", "files", "gradient_text",
            "hubspot_form", "group", "post_select", "repeater"
          ]
        },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "placeholder": { "type": "string" },
        "required": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number" },
        "options": { "type": "object", "additionalProperties": { "type": "string" } },
        "fields": { "$ref": "#/$defs/fieldList" }
      },
      "if": { "properties": { "type": { "enum": ["group", "repeater"] } } },
      "then": { "required": ["fields"] },
      "else": { "not": { "required": ["fields"] } }
    },
    "level": { "enum": ["open", "guided", "structured", "locked"], "description": "Editing preset level, from least to most locked." },
    "contentRule": {
      "oneOf": [
        { "$ref": "#/$defs/level" },
        {
          "type": "object",
          "properties": {
            "level": { "$ref": "#/$defs/level" },
            "allow": { "type": ["array", "null"], "items": { "type": "string", "pattern": "^(\\*|[a-z0-9-]+/(\\*|[a-z0-9-]+))$" }, "description": "Block names or globs that can be inserted (e.g. core/*); null = every block." },
            "template": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/blockTemplate" }] },
            "lock": { "enum": [false, "insert", "contentOnly", "all"] },
            "newPostsOnly": { "type": "boolean", "description": "Apply the starting template to new posts only (default true)." }
          },
          "additionalProperties": false
        }
      ]
    },
    "blockTemplate": {
      "type": "array",
      "description": "[\"block/name\", {attributes}, [inner blocks]] entries, as in register_post_type()'s template argument.",
      "items": {
        "type": "array", "minItems": 1, "maxItems": 3,
        "prefixItems": [{ "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" }, { "type": "object" }, { "$ref": "#/$defs/blockTemplate" }]
      }
    },
    "siteLayer": {
      "oneOf": [
        { "$ref": "#/$defs/level" },
        {
          "type": "object",
          "description": "true = can be edited, false = locked.",
          "properties": {
            "level": { "$ref": "#/$defs/level" },
            "templates": { "type": "boolean" }, "templateParts": { "type": "boolean" }, "globalStyles": { "type": "boolean" },
            "navigation": { "type": "boolean" }, "templateMode": { "type": "boolean" }, "siteEditor": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    },
    "designLayer": {
      "oneOf": [
        { "$ref": "#/$defs/level" },
        {
          "type": "object",
          "description": "true = custom values allowed, false = presets only.",
          "properties": {
            "level": { "$ref": "#/$defs/level" },
            "customColors": { "type": "boolean" }, "customGradients": { "type": "boolean" }, "customFontSizes": { "type": "boolean" },
            "dropCap": { "type": "boolean" }, "customSpacing": { "type": "boolean" }, "customLineHeight": { "type": "boolean" },
            "border": { "type": "boolean" }, "shadow": { "type": "boolean" }, "duotone": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    },
    "featuresLayer": {
      "oneOf": [
        { "$ref": "#/$defs/level" },
        {
          "type": "object",
          "description": "true = available, false = turned off.",
          "properties": {
            "level": { "$ref": "#/$defs/level" },
            "codeEditor": { "type": "boolean" }, "customHtml": { "type": "boolean" }, "blockDirectory": { "type": "boolean" },
            "openverse": { "type": "boolean" }, "remotePatterns": { "type": "boolean" }, "corePatterns": { "type": "boolean" },
            "blockLocking": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
