{
    "name": "taw-data-panel",
    "version": "0.0.0",
    "description": "The TAW Data sidebar for the block editor (taw/core ADR-0007). Built into ../../assets/data-panel/ (committed).",
    "private": true,
    "license": "GPL-2.0-or-later",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^22.20.4",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@wordpress/components": "~30.9.0",
        "@wordpress/element": "~6.41.0",
        "@wordpress/i18n": "^6.29.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.12.0",
        "jsdom": "^30.1.1",
        "prettier": "^3.9.9",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "sass": "^1.105.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.1",
        "vitest": "^5.0.2"
    }
}
