{
    "name": "taw/core",
    "description": "TAW Theme Framework — block system, metabox engine, Vite asset pipeline for WordPress",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Marco Del Riego",
            "email": "marck94zac1@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/console": "^7.4",
        "enshrined/svg-sanitize": "^0.22.0"
    },
    "require-dev": {
        "spatie/mjml-php": "^1.0",
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "suggest": {
        "emailit/emailit-php": "Required for EmailConfig::useEmailit() — route all wp_mail() through the Emailit REST API"
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=-1"
    },
    "autoload": {
        "psr-4": {
            "TAW\\": "src/"
        },
        "files": [
            "src/Support/performance.php",
            "src/Support/utilities.php"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
