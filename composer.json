{
    "name": "taw/core",
    "description": "TAW — data layer framework for WordPress (fields, options, REST-exposed meta, content interchange), plus an optional classic-theme toolkit (block system, Vite asset pipeline)",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Marco Del Riego",
            "email": "marck94zac1@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/console": "^7.4",
        "symfony/process": "^7.4",
        "enshrined/svg-sanitize": "^0.22.0"
    },
    "require-dev": {
        "spatie/mjml-php": "^1.0",
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpunit/phpunit": "^11",
        "brain/monkey": "^2.6",
        "emailit/emailit-php": "^2.0"
    },
    "suggest": {
        "ext-pdo_sqlite": "Required for the SQLite-backed features only (RAG knowledge bases, the Bible/Catechism SQLite readers, corpus:export). Everything else — including the whole data layer — works without it; the corpus readers fall back to MySQL (ADR-0002).",
        "emailit/emailit-php": "Required for EmailConfig::useEmailit() — route all wp_mail() through the Emailit REST API"
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=-1",
        "test": "phpunit",
        "i18n:pot": "php tools/i18n.php pot",
        "i18n:po": "php tools/i18n.php po",
        "i18n:compile": "php tools/i18n.php compile",
        "i18n:check": "php tools/i18n.php check"
    },
    "autoload": {
        "psr-4": {
            "TAW\\": "src/"
        },
        "files": [
            "src/Support/performance.php",
            "src/Support/utilities.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "TAW\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
